---
import { url } from '../utils/urls';
interface Props { src: string; alt: string; caption: string; width?: number; height?: number; }
const {src,alt,caption,width = 960,height = 540} = Astro.props;
---
<figure><a class="figure-link" href={url(src)} aria-label={alt + ' — open full-size image'}><img src={url(src)} alt={alt} loading="lazy" width={width} height={height} /></a><figcaption>{caption}</figcaption></figure>
